<section id="contact" class="section">
  <div class="contact-bg" aria-hidden="true">
    <span class="contact-blob contact-blob-a"></span>
    <span class="contact-blob contact-blob-b"></span>
  </div>
  <div class="container">
    <h2 class="fade-in section-title" data-i18n="contact.subtitle">Let's Connect</h2>
    <div class="contact-grid fade-in">
      <div class="contact-card contact-form">
        <h3 class="contact-form-title" data-i18n="contact.form_title">Send a message</h3>
        <form id="contactForm" class="contact-form-inner">
          <div class="input-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="input-icon"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <input type="text" id="contactName" class="input" data-i18n-placeholder="contact.name" placeholder="Name" />
          </div>
          <div class="input-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="input-icon"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
            <input type="email" id="contactEmail" class="input" data-i18n-placeholder="contact.email" placeholder="Email" required />
          </div>
          <div class="input-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="input-icon"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            <textarea id="contactMessage" class="input textarea" rows="5" data-i18n-placeholder="contact.message" placeholder="Message"></textarea>
          </div>
          <button type="submit" class="btn btn-primary btn-send" data-i18n="contact.send">Send Message</button>
        </form>
        <script>
          document.getElementById('contactForm').addEventListener('submit', function(e) {
            e.preventDefault();
            var name = document.getElementById('contactName').value;
            var email = document.getElementById('contactEmail').value;
            var message = document.getElementById('contactMessage').value;
            var body = 'Name: ' + name + '%0D%0AEmail: ' + email + '%0D%0A%0D%0A' + message;
            window.location.href = 'mailto:mardiansyah.gunting@yahoo.com?subject=Portfolio%20Contact&body=' + body;
          });
        </script>
      </div>

      <div class="contact-card contact-info">
        <h3 class="contact-info-title" data-i18n="contact.info_title">Contact Info</h3>
        <div class="contact-items">
          <div class="contact-pill">
            <span class="contact-pill-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
            </span>
            <div class="contact-pill-text">
              <strong data-i18n="contact.email_label">Email:</strong>
              <span data-i18n="contact.email_addr">mardiansyah.gunting@yahoo.com</span>
            </div>
          </div>
          <div class="contact-pill">
            <span class="contact-pill-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </span>
            <div class="contact-pill-text">
              <strong data-i18n="contact.phone_label">Phone:</strong>
              <span data-i18n="contact.phone">+628213105752</span>
            </div>
          </div>
          <div class="contact-pill">
            <span class="contact-pill-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </span>
            <div class="contact-pill-text">
              <strong data-i18n="contact.location_label">Location:</strong>
              <span data-i18n="contact.location">Palangka Raya, Indonesia</span>
            </div>
          </div>
          <div class="contact-pill contact-pill-social">
            <span class="contact-pill-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
