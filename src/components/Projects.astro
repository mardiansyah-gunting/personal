---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const projects = [
  {
    index: 0,
    color: "#10b981",
    private: true,
    title: "DMRV",
    link: null,
    desc: "Internal application for TREEO Indonesia that digitizes the Measurement, Reporting & Verification (MRV) of field tree-planting data. Built end-to-end, in daily production use, and maintained over time — scheduled for release in Q1 2027.",
    tags: ["Python", "Data Pipeline", "Production"],
  },
  {
    index: 1,
    color: "#3b82f6",
    private: true,
    title: "TREEO Indonesia Website",
    link: null,
    website: "https://treeo.id",
    desc: "I helped improve the TREEO Indonesia website — fixed and improved the animations and built a responsive mobile layout so the site works smoothly on phones.",
    tags: ["Web Development", "Animation", "Responsive Design"],
  },
  {
    index: 2,
    color: "#f59e0b",
    title: "Bakul",
    link: "https://github.com/mardiansyah-gunting/Bakul",
    desc: "Financial recording app to track income and expenses with full transaction history and monthly reports. Prototype first designed in Figma.",
    tags: ["Kotlin", "Android Studio", "Figma"],
  },
  {
    index: 3,
    color: "#22c55e",
    title: "Counter",
    link: "https://github.com/mardiansyah-gunting/Counter",
    desc: "Seedling counting tool for nurseries — built during coffee breaks to support agroforestry work in the field.",
    tags: ["Kotlin", "Android"],
  },
  {
    index: 4,
    color: "#6366f1",
    title: "CAD Converter",
    link: "https://github.com/mardiansyah-gunting/CAD-converter",
    desc: "Python utility that converts AutoCAD DWG/DXF files into Esri Shapefile or GeoJSON using GDAL and GeoPandas, ready for GIS analysis and API integration.",
    tags: ["Python", "GDAL", "GeoPandas", "GIS"],
  },
  {
    index: 5,
    color: "#14b8a6",
    title: "Tree Monitoring",
    link: "https://github.com/mardiansyah-gunting/tree-monitoring",
    desc: "Native Android app for farmers and field officers: identify plant species, assess tree health, record DBH measurements, and plot land with GPS walk. Bilingual (ID/EN).",
    tags: ["Kotlin", "Jetpack Compose", "Material 3", "GPS"],
  },
  {
    index: 6,
    color: "#8b5cf6",
    title: "WA Broadcast",
    link: "https://github.com/mardiansyah-gunting/wa-broadcast",
    desc: "Python tool to send bulk WhatsApp messages in one go.",
    tags: ["Python", "Bulk Messaging"],
  },
  {
    index: 7,
    color: "#ef4444",
    title: "YouTube Downloader",
    link: "https://github.com/mardiansyah-gunting/youtube-downloader",
    desc: "Python tool for downloading media from YouTube.",
    tags: ["Python", "Download Tool"],
  },
  {
    index: 8,
    color: "#06b6d4",
    title: "TechMentoring",
    link: "https://github.com/mardiansyah-gunting/TechMentoring",
    desc: "Structured mentoring materials and hands-on exercises for technical sessions — Python, data handling, and security log analysis.",
    tags: ["Python", "Mentoring", "Teaching"],
  },
  {
    index: 9,
    color: "#f97316",
    title: "Nulis",
    link: "https://github.com/mardiansyah-gunting/Nulis",
    desc: "Note-taking Android app built with Kotlin — a simple place to jot things down.",
    tags: ["Kotlin", "Android"],
  },
  {
    index: 10,
    color: "#64748b",
    title: "Folder Mover",
    link: "https://github.com/mardiansyah-gunting/folder-mover",
    desc: "Safe folder consolidation utility — merges and organizes folders (like Google Takeout) without overwriting existing files, then cleans up empty directories.",
    tags: ["Python", "File Management", "Backup"],
  },
  {
    index: 11,
    color: "#a855f7",
    title: "Suit Game Terminal",
    link: "https://github.com/mardiansyah-gunting/SuitGameTerminal",
    desc: "Rock-paper-scissors game playable directly in the command line, built in Kotlin.",
    tags: ["Kotlin", "CLI Game"],
  },
  {
    index: 12,
    color: "#ec4899",
    title: "Kertas Batu Gunting",
    link: "https://github.com/mardiansyah-gunting/kertas-batu-gunting",
    desc: "Playful rock-paper-scissors game with a dark theme, best-of-5 scoring, smooth animations, and 3-language support (ID/EN/ZH).",
    tags: ["Kotlin", "Android", "Game"],
  },
];
---

<section id="projects" class="section">
  <div class="container">
    <h2 class="fade-in section-title" data-i18n="projects.subtitle">Things I've Built</h2>
    <p class="fade-in section-subtitle project-intro" data-i18n="projects.intro">
      A selection of applications and tools I've built — plus internal work at TREEO Indonesia that I can't publish publicly.
    </p>
    <div class="projects-grid">
      <article class="project-card project-automation fade-in" style="--pc: #6366f1">
        <div class="automation-body">
          <div class="automation-head">
            <h3 class="project-title" data-i18n="projects.automation.title">Workflow Automation</h3>
            <span class="project-badge" data-i18n="projects.internal_badge">Internal</span>
          </div>
          <p class="project-desc" data-i18n="projects.automation.desc">
            At Fairventures Digital GmbH I built internal Python scripts that turn raw data into exactly what the team needs — extracted, transformed, or patched into the format they ask for, on demand. Confidential and in daily use, so the source never leaves the company.
          </p>
          <div class="project-tags">
            <span class="tag-proj">Python</span>
            <span class="tag-proj">Automation</span>
            <span class="tag-proj">Data Pipeline</span>
            <span class="tag-proj">Productivity</span>
          </div>
          <div class="project-tools">
            <span class="project-tools-label" data-i18n="projects.automation.tools_label">Built with</span>
            <div class="project-tools-chips">
              <span class="tool-chip">pandas</span>
              <span class="tool-chip">openpyxl</span>
              <span class="tool-chip">python-dotenv</span>
              <span class="tool-chip">schedule</span>
              <span class="tool-chip">logging</span>
            </div>
          </div>
        </div>
        <div class="automation-flow">
          <button type="button" class="auto-zoom-btn" id="autoZoomBtn" aria-label="Open the workflow diagram to zoom in">
            <img src={`${baseUrl}/images/automation-flow.png`} alt="How the automation works" class="auto-flow-img" width="840" height="330" loading="lazy" />
            <span class="auto-zoom-hint">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3M11 8v6M8 11h6"/></svg>
              <span data-i18n="projects.automation.zoom_hint">Click to zoom</span>
            </span>
          </button>
        </div>
      </article>
      {projects.map(p => (
        <article
          class="project-card fade-in"
          style={`--pc: ${p.color}`}
          data-project={p.index}
        >
          <div class="project-illo" aria-hidden="true">
