<script>
(function () {
  var btn = document.getElementById('autoZoomBtn');
  var ov = document.getElementById('autoMz');
  var vp = document.getElementById('autoMzViewport');
  var cv = document.getElementById('autoMzCanvas');
  var pct = document.getElementById('autoMzPct');
  if (!btn || !ov || !vp || !cv || !pct) return;
  var src = btn.querySelector('img');
  var s = 1, tx = 0, ty = 0;
  var MIN = 0.6, MAX = 2;

  function apply() {
    cv.style.transform = 'translate(' + tx + 'px,' + ty + 'px) scale(' + s + ')';
    pct.textContent = Math.round(s * 100) + '%';
  }

  function zoomTo(ns, cx, cy) {
    ns = Math.min(MAX, Math.max(MIN, ns));
    if (cx !== undefined && cy !== undefined) {
      tx = cx - (cx - tx) * (ns / s);
      ty = cy - (cy - ty) * (ns / s);
    }
    s = ns;
    apply();
  }

  function reset() {
    s = 1; tx = 0; ty = 0;
    apply();
  }

  function open() {
    if (!src) return;
    cv.innerHTML = '';
    cv.appendChild(src.cloneNode(true));
    reset();
    ov.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function close() {
    ov.classList.remove('open');
    cv.innerHTML = '';
    document.body.style.overflow = '';
  }

  btn.addEventListener('click', open);
  document.getElementById('autoMzClose').addEventListener('click', close);
  ov.addEventListener('click', function (e) {
    if (e.target === ov) close();
  });

  document.getElementById('autoMzOut').addEventListener('click', function () {
    var r = vp.getBoundingClientRect();
    zoomTo(s - 0.25, r.left + r.width / 2, r.top + r.height / 2);
  });
  document.getElementById('autoMzIn').addEventListener('click', function () {
    var r = vp.getBoundingClientRect();
    zoomTo(s + 0.25, r.left + r.width / 2, r.top + r.height / 2);
  });
  document.getElementById('autoMzReset').addEventListener('click', reset);

  vp.addEventListener('wheel', function (e) {
    e.preventDefault();
    var r = vp.getBoundingClientRect();
    var f = e.deltaY < 0 ? 1.12 : 1 / 1.12;
    zoomTo(s * f, e.clientX - r.left, e.clientY - r.top);
  }, { passive: false });

  var dragging = false, startX = 0, startY = 0, ox = 0, oy = 0;
  vp.addEventListener('pointerdown', function (e) {
    if (e.button !== 0 && e.pointerType === 'mouse') return;
    dragging = true;
    startX = e.clientX; startY = e.clientY;
    ox = tx; oy = ty;
    vp.classList.add('grabbing');
    try { vp.setPointerCapture(e.pointerId); } catch (err) {}
  });
  vp.addEventListener('pointermove', function (e) {
    if (!dragging) return;
    tx = ox + (e.clientX - startX);
    ty = oy + (e.clientY - startY);
    apply();
  });
  function stopDrag() {
    dragging = false;
    vp.classList.remove('grabbing');
  }
  vp.addEventListener('pointerup', stopDrag);
  vp.addEventListener('pointercancel', stopDrag);

  document.addEventListener('keydown', function (e) {
    if (ov.classList.contains('open') && e.key === 'Escape') close();
  });
})();
</script>