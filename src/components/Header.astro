---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const navItems = [
  { key: 'home', href: '#home' },
  { key: 'about', href: '#about' },
  { key: 'experience', href: '#experience' },
  { key: 'projects', href: '#projects' },
  { key: 'skills', href: '#skills' },
  { key: 'education', href: '#education' },
  { key: 'contact', href: '#contact' },
];
---

<header class="header" id="header">
  <nav class="nav-pill" id="nav">
    <ul class="nav-list">
      {navItems.map(item => (
        <li><a href={item.href} class="nav-link" data-i18n={`nav.${item.key}`}>{item.key}</a></li>
      ))}
    </ul>
    <div class="nav-divider"></div>
    <div class="lang-switch">
      <button class="lang-btn" data-lang="en">EN</button>
      <button class="lang-btn" data-lang="id">ID</button>
      <button class="lang-btn" data-lang="zh">中文</button>
    </div>
    <button id="menuToggle" class="menu-btn" aria-label="Toggle menu" aria-expanded="false">
      <span class="menu-icon">
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
      </span>
    </button>
  </nav>

  <div class="mobile-menu" id="mobileMenu" aria-hidden="true">
    <div class="mm-deco" aria-hidden="true">
      <svg viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="360" cy="40" r="120" stroke="currentColor" stroke-width="1" opacity="0.06"/>
        <circle cx="40" cy="370" r="90" stroke="currentColor" stroke-width="1" opacity="0.05"/>
        <circle cx="330" cy="340" r="50" stroke="currentColor" stroke-width="1" opacity="0.05"/>
        <circle cx="70" cy="60" r="6" fill="currentColor" opacity="0.08"/>
        <circle cx="340" cy="120" r="4" fill="currentColor" opacity="0.08"/>
        <circle cx="60" cy="320" r="4" fill="currentColor" opacity="0.08"/>
      </svg>
    </div>
    <div class="mm-inner">
      <div class="mm-profile">
        <img src={`${baseUrl}/profile.jpg`} alt="Mardiansyah Gunting" class="mm-avatar" />
        <div>
          <div class="mm-name">Mardiansyah Gunting</div>
          <div class="mm-tagline" data-i18n="hero.subtitle">Project Management · Data Automation · Operational Excellence</div>
        </div>
      </div>
      <ul class="mm-links">
        {navItems.map((item, i) => (
          <li>
            <a href={item.href} class="mm-link" data-i18n={`nav.${item.key}`} style={`--d: ${(0.07 * (i + 1) + 0.08).toFixed(2)}s`}>
              <span class="mm-index">{String(i + 1).padStart(2, '0')}</span>
              <span>{item.key}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="mm-foot">
        <div class="mm-socials">
          <a href="https://github.com/mardiansyah-gunting" target="_blank" rel="noopener noreferrer">GitHub</a>
          <span class="mm-sep">·</span>
          <a href="https://linkedin.com/in/mardiansyah-gunting" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <span class="mm-sep">·</span>
          <a href="https://wa.me/628213105752" target="_blank" rel="noopener noreferrer">WhatsApp</a>
          <span class="mm-sep">·</span>
          <a href="weixin://dl/chat?wxid_f4jlf94gw5p22">WeChat</a>
        </div>
        <a href="mailto:mardiansyah.gunting@yahoo.com" class="mm-email">mardiansyah.gunting@yahoo.com</a>
      </div>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 1rem;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  .nav-pill {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(226, 232, 240, 0.8);
    border-radius: 100px;
    padding: 0.5rem 1rem;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
    pointer-events: auto;
    transition: box-shadow 0.3s;
    position: relative;
    z-index: 96;
  }

  .nav-pill:hover {
    box-shadow: 0 6px 32px rgba(0, 0, 0, 0.1);
  }

  .nav-list {
    display: flex;
    list-style: none;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: block;
    padding: 0.4rem 0.85rem;
    border-radius: 100px;
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 500;
    transition: all 0.2s;
    white-space: nowrap;
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 3px;
    left: 50%;
    width: 0;
    height: 2.5px;
    background: var(--accent);
    border-radius: 2px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    transform: translateX(-50%);
  }

  .nav-link.active::after {
    width: 60%;
  }

  .nav-link:hover {
    color: var(--primary);
    background: var(--bg-alt);
    text-decoration: none;
  }

  .nav-link.active {
    color: var(--accent);
    background: rgba(59, 130, 246, 0.08);
  }

  .nav-divider {
    width: 1px;
    height: 24px;
    background: var(--border);
    margin: 0 0.25rem;
  }

  .lang-switch {
    display: flex;
    gap: 0.15rem;
  }

  .lang-btn {
    background: none;
    border: none;
    border-radius: 100px;
    padding: 0.3rem 0.55rem;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    color: var(--text-muted);
    transition: all 0.2s;
  }

  .lang-btn:hover {
    color: var(--primary);
    background: var(--bg-alt);
  }

  .lang-btn.active {
    background: var(--primary);
    color: #fff;
  }

  .menu-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.35rem;
    color: var(--text-muted);
    border-radius: 100px;
    transition: all 0.2s;
    display: none;
    line-height: 1;
  }

  .menu-btn:hover {
    background: var(--bg-alt);
    color: var(--primary);
  }

  .menu-icon {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 18px;
    height: 14px;
  }

  .menu-bar {
    display: block;
    width: 100%;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: all 0.3s ease;
    transform-origin: center;
  }

  .nav-pill.open .menu-bar:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .nav-pill.open .menu-bar:nth-child(2) {
    opacity: 0;
  }

  .nav-pill.open .menu-bar:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 95;
    background: var(--bg);
    pointer-events: auto;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease, visibility 0.35s ease;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .mobile-menu.open {
    opacity: 1;
    visibility: visible;
  }

  .mm-deco {
    position: absolute;
    inset: 0;
    pointer-events: none;
    color: var(--accent);
  }

  .mm-deco svg {
    width: 100%;
    height: 100%;
  }

  .mm-inner {
    position: relative;
    min-height: 100%;
    display: flex;
    flex-direction: column;
    padding: 1.25rem 2rem 2rem;
  }

  .mm-profile {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding-top: 3.25rem;
    margin-bottom: 2rem;
  }

  .mm-avatar {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--accent);
    box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.12);
    flex-shrink: 0;
  }

  .mm-name {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--primary);
  }

  .mm-tagline {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-top: 0.15rem;
    line-height: 1.4;
  }

  .mm-links {
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.25rem;
  }

  .mm-link {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.45s ease, transform 0.45s ease;
    transition-delay: 0s;
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.55rem 0.5rem;
    border-radius: 12px;
    color: var(--text);
    font-size: clamp(1.35rem, 7vw, 2rem);
    font-weight: 700;
    line-height: 1.2;
  }

  .mobile-menu.open .mm-link {
    opacity: 1;
    transform: none;
    transition-delay: var(--d, 0s);
  }

  .mm-link:hover {
    text-decoration: none;
    color: var(--accent);
    background: rgba(59, 130, 246, 0.06);
  }

  .mm-link.active {
    color: var(--accent);
  }

  .mm-index {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent);
    opacity: 0.7;
    letter-spacing: 0.06em;
    flex-shrink: 0;
    min-width: 1.9rem;
  }

  .mm-foot {
    margin-top: 2rem;
    text-align: center;
  }

  .mm-socials {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .mm-socials a {
    color: var(--text-muted);
    padding: 0.3rem 0.45rem;
    border-radius: 100px;
  }

  .mm-socials a:hover {
    color: var(--accent);
    background: var(--bg-alt);
    text-decoration: none;
  }

  .mm-sep {
    color: var(--border);
  }

  .mm-email {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .mm-email:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  @media (min-width: 769px) {
    .mobile-menu {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .header {
      top: 0.75rem;
    }

    .nav-pill {
      border-radius: 16px;
      padding: 0.5rem 0.75rem;
      flex-wrap: nowrap;
    }

    .nav-list {
      display: none;
    }

    .nav-divider {
      display: none;
    }

    .menu-btn {
      display: block;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var nav = document.getElementById('nav');
    var menu = document.getElementById('mobileMenu');
    var toggle = document.getElementById('menuToggle');
    var prevOverflow = '';

    function setMenu(open) {
      nav.classList.toggle('open', open);
      menu.classList.toggle('open', open);
      menu.setAttribute('aria-hidden', open ? 'false' : 'true');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      document.body.style.overflow = open ? 'hidden' : prevOverflow;
    }

    toggle.addEventListener('click', function() {
      setMenu(!nav.classList.contains('open'));
    });

    function scrollToSection(id) {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var behavior = reduce ? 'auto' : 'smooth';
      var vh = window.innerHeight;
      var pin = document.querySelector('.hero-pin');
      var isNarrow = window.matchMedia && window.matchMedia('(max-width: 768px)');
      if (id === 'home') {
        window.scrollTo({ top: 0, behavior: behavior });
        return;
      }
      var headerEl = document.getElementById('header');
      var headerH = headerEl ? headerEl.getBoundingClientRect().top + headerEl.offsetHeight + 14 : 80;
      var el = document.getElementById(id);
      if (!el) return;
      var y;
      if (id === 'about' && pin && !reduce) {
        var pinTop = pin.offsetTop;
        var travel = pin.offsetHeight - vh;
        var revealP = isNarrow && isNarrow.matches ? 0.72 : 0.58;
        y = pinTop + travel * revealP;
      } else {
        y = el.getBoundingClientRect().top + window.pageYOffset - headerH;
      }
      window.scrollTo({ top: Math.max(0, y), behavior: behavior });
    }

    document.querySelectorAll('.nav-link, .mm-link').forEach(function(link) {
      link.addEventListener('click', function(e) {
        var href = link.getAttribute('href');
        if (href && href.charAt(0) === '#') {
          e.preventDefault();
          setMenu(false);
          scrollToSection(href.slice(1));
        } else {
          setMenu(false);
        }
      });
    });

    menu.addEventListener('click', function(e) {
      if (e.target === menu) setMenu(false);
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && nav.classList.contains('open')) setMenu(false);
    });

    window.addEventListener('resize', function() {
      if (window.innerWidth > 768 && nav.classList.contains('open')) setMenu(false);
    });

    var allLinks = document.querySelectorAll('.nav-link, .mm-link');

    function setActive(id) {
      allLinks.forEach(function(link) {
        link.classList.toggle('active', link.getAttribute('href') === '#' + id);
      });
    }

    document.addEventListener('sectionchange', function(e) {
      if (e.detail && e.detail.id) setActive(e.detail.id);
    });

    if (allLinks[0]) setActive('home');
  });
</script>
