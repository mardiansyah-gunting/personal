---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const cv = {
  en: 'https://ap.wps.com/cms/docs/d/cbPaes8mwZdX9lII',
  id: 'https://ap.wps.com/cms/docs/d/cbPaeocVk7PaNV6q',
  zh: 'https://ap.wps.com/cms/docs/d/cbPaedq51hh7xth3',
};
---
<section id="home" class="hero">
  <div class="hero-bg" aria-hidden="true">
    <svg class="hero-blob hero-blob-1" viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="200" cy="200" r="200" fill="currentColor" opacity="0.04"/>
    </svg>
    <svg class="hero-blob hero-blob-2" viewBox="0 0 300 300" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="150" cy="150" r="150" fill="currentColor" opacity="0.03"/>
    </svg>
    <svg class="hero-blob hero-blob-3" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="100" cy="100" r="100" fill="currentColor" opacity="0.05"/>
    </svg>
    <svg class="hero-dots" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="10" cy="10" r="3" fill="currentColor" opacity="0.12"/>
      <circle cx="50" cy="30" r="2.5" fill="currentColor" opacity="0.1"/>
      <circle cx="90" cy="10" r="3" fill="currentColor" opacity="0.08"/>
      <circle cx="130" cy="40" r="2" fill="currentColor" opacity="0.1"/>
      <circle cx="170" cy="15" r="3" fill="currentColor" opacity="0.12"/>
      <circle cx="30" cy="60" r="2.5" fill="currentColor" opacity="0.08"/>
      <circle cx="70" cy="80" r="2" fill="currentColor" opacity="0.1"/>
      <circle cx="110" cy="90" r="3" fill="currentColor" opacity="0.08"/>
      <circle cx="150" cy="70" r="2.5" fill="currentColor" opacity="0.12"/>
      <circle cx="10" cy="110" r="2" fill="currentColor" opacity="0.1"/>
      <circle cx="50" cy="130" r="3" fill="currentColor" opacity="0.08"/>
      <circle cx="90" cy="150" r="2.5" fill="currentColor" opacity="0.12"/>
      <circle cx="60" cy="170" r="2" fill="currentColor" opacity="0.1"/>
      <circle cx="140" cy="120" r="3" fill="currentColor" opacity="0.08"/>
      <circle cx="180" cy="160" r="2" fill="currentColor" opacity="0.1"/>
    </svg>
  </div>
  <div class="hero-stage container">
    <div class="hero-intro">
      <div class="fade-in hero-badge" data-i18n="hero.tagline">Reliable Operator | Automation Builder</div>
      <h1 class="fade-in hero-name" data-i18n="hero.name">Mardiansyah Gunting</h1>
      <p class="fade-in hero-subtitle" data-i18n="hero.subtitle">Project Management · Data Automation · Operational Excellence</p>
      <div class="fade-in hero-actions">
        <a href="#contact" class="btn btn-primary" data-i18n="hero.cta_contact">Get in Touch</a>
        <div class="cv-dropdown" id="cvDropdown">
          <button type="button" class="btn btn-outline cv-btn" id="cvBtn" aria-haspopup="menu" aria-expanded="false">
            <span data-i18n="hero.cta_cv">Download CV</span>
            <svg class="cv-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="cv-menu" id="cvMenu" role="menu">
            <a role="menuitem" href={cv.en} target="_blank" rel="noopener noreferrer">English</a>
            <a role="menuitem" href={cv.id} target="_blank" rel="noopener noreferrer">Indonesia</a>
            <a role="menuitem" href={cv.zh} target="_blank" rel="noopener noreferrer">中文</a>
          </div>
        </div>
      </div>
      <div class="fade-in hero-social">
        <a href="https://github.com/mardiansyah-gunting" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="GitHub">
          <svg viewBox="0 0 24 24" fill="currentColor" width="22" height="22"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12z"/></svg>
        </a>
        <a href="https://linkedin.com/in/mardiansyah-gunting" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" fill="currentColor" width="22" height="22"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
      </div>
    </div>
    <div class="hero-photo-wrap">
      <img src={`${baseUrl}/profile.jpg`} alt="Mardiansyah Gunting" class="hero-photo-img" width="220" height="220" fetchpriority="high" data-zoom />
    </div>
    <div class="hero-desc">
      <article class="about-card" aria-labelledby="aboutEyebrow">
        <h2 class="about-eyebrow" id="aboutEyebrow" data-i18n="about.eyebrow">Who I Am</h2>
        <p class="about-lead" data-i18n="about.lead">I work where operations, technology, and strategy meet — bridging teams, building the tools they need, and clearing away the repetitive work that quietly slows a business down.</p>
        <p class="about-text" data-i18n="about.p1">Most of that has meant automating data requests with Python and moving reporting out of spreadsheets and into systems people actually enjoy using. Whether I'm coordinating tree-planting programmes across Indonesia or shipping an Android app, the goal stays the same: something measurable and built to last.</p>
        <p class="about-text" data-i18n="about.p2">Working alongside startups, international NGOs, and government institutions has taught me to adapt quickly and communicate across cultures — and convinced me that the best outcomes come from pairing real domain knowledge with the right technology. I'm open to new roles and collaborations, and I'd be glad to talk.</p>
        <div class="about-focus" data-i18n-tags="about.focus"><span class="tag">Operations</span><span class="tag">Python Automation</span><span class="tag">Cross-cultural Teams</span></div>
      </article>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    position: sticky;
    top: 0;
    overflow: hidden;
    text-align: center;
    display: flex;
    flex-direction: column;
    background: var(--bg);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    color: var(--primary);
  }

  .hero-blob {
    position: absolute;
    animation: heroFloat 8s ease-in-out infinite;
  }

  .hero-blob-1 {
    width: 500px;
    height: 500px;
    top: -100px;
    right: -100px;
    animation-delay: 0s;
  }

  .hero-blob-2 {
    width: 350px;
    height: 350px;
    bottom: -50px;
    left: -80px;
    animation-delay: -3s;
  }

  .hero-blob-3 {
    width: 200px;
    height: 200px;
    top: 40%;
    left: 60%;
    animation-delay: -6s;
  }

  .hero-dots {
    position: absolute;
    width: 250px;
    height: 250px;
    bottom: 20%;
    right: 10%;
    animation: heroFloat 10s ease-in-out infinite;
    animation-delay: -4s;
  }

  @keyframes heroFloat {
    0%, 100% { transform: translateY(0) translateY(var(--px, 0px)) rotate(0deg); }
    50% { transform: translateY(-20px) translateY(var(--px, 0px)) rotate(2deg); }
  }

  .hero-stage {
    max-width: 900px;
    width: 100%;
    margin: auto;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    padding: 6rem 1.5rem 4rem;
  }
  .hero-intro {
    display: contents;
  }
  .hero-photo-wrap {
    order: 3;
    position: relative;
    z-index: 2;
    width: min(220px, 22vw);
    aspect-ratio: 1;
    margin: 0;
    flex: 0 0 auto;
    will-change: transform;
  }

  .hero-photo-wrap::before {
    content: '';
    position: absolute;
    inset: -14px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    opacity: 0.25;
  }

  .hero-photo-wrap::after {
    content: '';
    position: absolute;
    inset: -30px;
    border-radius: 50%;
    border: 1px dashed var(--accent);
    opacity: 0.2;
    animation: heroSpin 26s linear infinite;
  }

  .hero-stage.is-revealed .hero-actions,
  .hero-stage.is-revealed .hero-social {
    display: none;
  }

  /* ---- About: Fluent-style acrylic card ----
     One element serves both layouts: on desktop the scroll script slides it in
     beside the portrait; on mobile it replaces the intro once .is-revealed. */
  .hero-desc {
    order: 4;
    display: none;
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
    text-align: left;
  }
  .about-card {
    --mx: 50%;
    --my: 0%;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 1.6rem 1.75rem 1.5rem;
    border-radius: 16px;
    /* acrylic: translucent tint + blur of the blobs behind it */
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.82), rgba(246, 251, 249, 0.66));
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    backdrop-filter: blur(24px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.75);
    /* Fluent elevation: hairline stroke + short key shadow + long ambient shadow */
    box-shadow:
      0 0 0 1px rgba(0, 51, 41, 0.07),
      0 2px 6px rgba(0, 51, 41, 0.06),
      0 18px 40px -10px rgba(0, 51, 41, 0.18);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }
  /* reveal highlight: a soft light that follows the pointer */
  .about-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(420px circle at var(--mx) var(--my), rgba(0, 128, 43, 0.1), rgba(0, 128, 43, 0) 60%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  /* top-edge accent, like Fluent's lit border */
  .about-card::after {
    content: '';
    position: absolute;
    left: 1.75rem;
    right: 1.75rem;
    top: 0;
    height: 2px;
    border-radius: 0 0 2px 2px;
    background: linear-gradient(90deg, rgba(0, 128, 43, 0), rgba(0, 128, 43, 0.55), rgba(0, 128, 43, 0));
    pointer-events: none;
  }
  /* only on screens too short for the full text: fade hints there is more */
  .about-card.has-more {
    -webkit-mask-image: linear-gradient(180deg, #000 calc(100% - 3rem), rgba(0, 0, 0, 0.15));
    mask-image: linear-gradient(180deg, #000 calc(100% - 3rem), rgba(0, 0, 0, 0.15));
  }
  @media (hover: hover) and (pointer: fine) {
    .about-card:hover {
      box-shadow:
        0 0 0 1px rgba(0, 128, 43, 0.16),
        0 4px 10px rgba(0, 51, 41, 0.07),
        0 24px 48px -12px rgba(0, 51, 41, 0.22);
    }
    .about-card:hover::before {
      opacity: 1;
    }
  }
  .about-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0 0 0.85rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--accent);
  }
  .about-eyebrow::after {
    content: '';
    flex: 1 1 auto;
    height: 1px;
    background: linear-gradient(90deg, rgba(0, 128, 43, 0.35), rgba(0, 128, 43, 0));
  }
  .about-lead {
    margin: 0 0 0.8rem;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.55;
    color: var(--text);
    text-wrap: pretty;
  }
  .about-text {
    margin: 0 0 0.7rem;
    font-size: 0.9rem;
    line-height: 1.75;
    color: var(--text-muted);
    text-wrap: pretty;
  }
  .about-focus {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(0, 128, 43, 0.12);
  }
  .about-focus :global(.tag) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    font-size: 0.76rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--primary);
    background: rgba(0, 128, 43, 0.08);
    border: 1px solid rgba(0, 128, 43, 0.16);
  }
  .about-focus :global(.tag)::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* Mobile: About replaces the intro once the pinned scroll reveals it */
  .hero-stage.is-revealed .hero-badge,
  .hero-stage.is-revealed .hero-name,
  .hero-stage.is-revealed .hero-subtitle {
    display: none;
  }
  .hero-stage.is-revealed .hero-photo-wrap {
    width: min(30vw, 120px);
  }
  .hero-stage.is-revealed .hero-desc {
    display: block;
    animation: heroAboutIn 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes heroAboutIn {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }

  @media (min-width: 769px) {
    .hero-desc {
      /* Photo is shifted -190px by the scroll script and scaled to 0.96;
         its outer dashed ring sits 30px outside the image. The card starts
         just past that ring at every stage width. */
      --photo-w: min(220px, 22vw);
      --photo-edge: calc(50% - 190px + 0.48 * var(--photo-w) + 29px);
      /* on wide screens let the card use some of the space beside the stage */
      --spill: clamp(0px, calc((100vw - 900px) / 2 - 4.5rem), 11rem);
      display: block;
      position: absolute;
      left: 0;
      right: calc(-1 * var(--spill));
      top: 50%;
      z-index: 1;
      width: auto;
      max-width: none;
      margin: 0;
      opacity: 0;
      transform: translateX(26px) translateY(-50%);
      pointer-events: none;
      will-change: transform, opacity;
      /* keep clear of the fixed section rail when the stage reaches the viewport edge */
      padding: 1rem max(1.5rem, calc(3.5rem - (100vw - 100%) / 2 - var(--spill))) 1rem calc(var(--photo-edge) + 2.2rem);
    }
    .about-card {
      max-width: 36rem;
      /* safety net: never taller than the screen; scrolls inside if it must */
      max-height: calc(100vh - 9rem);
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: rgba(0, 128, 43, 0.3) transparent;
    }
  }
  @media (min-width: 769px) and (max-width: 1024px) {
    .about-card {
      padding: 1.25rem 1.35rem 1.15rem;
    }
    .about-lead {
      font-size: 0.95rem;
      line-height: 1.5;
    }
    .about-text {
      font-size: 0.82rem;
      line-height: 1.55;
      margin-bottom: 0.45rem;
    }
    .about-focus {
      margin-top: 0.7rem;
      padding-top: 0.7rem;
    }
  }

  .hero-lb-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
    cursor: zoom-out;
  }
  .hero-lb-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }
  .hero-lb-overlay img {
    max-width: 90vw;
    max-height: 90vh;
    border-radius: 8px;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.5);
    cursor: default;
    user-select: none;
  }
  .hero-lb-close {
    position: absolute;
    top: 1rem;
    right: 1.5rem;
    color: #fff;
    font-size: 2rem;
    cursor: pointer;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    border: none;
  }
  .hero-lb-close:hover { background: rgba(255, 255, 255, 0.25); }

  .hero-photo-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    object-fit: cover;
    z-index: 1;
    box-shadow: 0 18px 44px rgba(0, 51, 41, 0.2);
    border: 4px solid #fff;
    cursor: zoom-in;
    transition: transform 0.3s ease;
    animation: heroPhotoFloat 6s ease-in-out infinite;
  }

  .hero-photo-img:hover {
    transform: scale(1.04);
    animation-play-state: paused;
  }

  @keyframes heroPhotoFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  @keyframes heroSpin {
    to { transform: rotate(360deg); }
  }

  .hero-badge {
    order: 0;
    display: inline-block;
    background: var(--accent);
    color: #fff;
    padding: 0.4rem 1rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 0;
    letter-spacing: 0.02em;
  }

  .hero-name {
    order: 1;
    font-size: clamp(2rem, 5.5vw, 3.4rem);
    font-weight: 800;
    color: var(--primary);
    line-height: 1.1;
    margin-bottom: 0;
  }

  .hero-subtitle {
    order: 2;
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: var(--text-muted);
    margin-bottom: 0;
    max-width: 560px;
  }

  .hero-actions {
    order: 5;
    position: relative;
    z-index: 40;
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .cv-dropdown {
    position: relative;
  }
  .cv-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .cv-caret {
    width: 14px;
    height: 14px;
    transition: transform 0.2s;
  }
  .cv-dropdown.open .cv-caret {
    transform: rotate(180deg);
  }
  .cv-menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    min-width: clamp(180px, 82vw, 220px);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 12px 32px rgba(0, 51, 41, 0.12);
    padding: 0.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    z-index: 50;
    opacity: 0;
    visibility: hidden;
    transform: translateX(-50%) translateY(-4px);
    transition: opacity 0.18s, transform 0.18s, visibility 0.18s;
  }
  .cv-dropdown.open .cv-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }
  .cv-menu a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text);
    transition: background 0.15s, color 0.15s;
  }
  .cv-menu a:hover {
    background: var(--bg-alt);
    color: var(--accent);
    text-decoration: none;
  }
  .hero-social {
    order: 6;
    display: flex;
    gap: 1rem;
    justify-content: center;
  }
  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--bg-alt);
    color: var(--text-muted);
    border: 1px solid var(--border);
    transition: all 0.25s;
  }
  .social-link:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: rgba(0, 128, 43, 0.06);
    transform: translateY(-2px);
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .hero-stage {
      gap: 1.1rem;
      padding: 5.5rem 1.2rem 3.5rem;
    }
    .hero-badge {
      font-size: 0.78rem;
      padding: 0.35rem 0.9rem;
    }
    .hero-name {
      font-size: clamp(1.8rem, 8vw, 2.4rem);
    }
    .hero-subtitle {
      font-size: 0.95rem;
      max-width: 92%;
    }
    .hero-photo-wrap {
      width: min(42vw, 160px);
    }
    /* revealed About: stage is locked to one screen; the card shrinks to fit
       and only scrolls internally on screens too short for the full text */
    .hero-stage.is-revealed {
      height: 100vh;
      height: 100svh;
      margin: 0 auto;
      gap: 1.15rem;
      padding-top: 5.4rem;
      padding-bottom: 1.25rem;
    }
    .hero-stage.is-revealed .hero-desc {
      display: flex;
      flex-direction: column;
      flex: 0 1 auto;
      min-height: 0;
    }
    /* tighter rings around the small portrait so they clear the header */
    .hero-stage.is-revealed .hero-photo-wrap::before {
      inset: -6px;
    }
    .hero-stage.is-revealed .hero-photo-wrap::after {
      inset: -12px;
    }
    .hero-stage.is-revealed .about-card {
      min-height: 0;
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: rgba(0, 128, 43, 0.3) transparent;
    }
    .hero-stage.is-revealed .hero-photo-wrap {
      width: min(20vw, 72px);
    }
    .about-card {
      padding: 1.15rem 1.2rem 1.05rem;
      border-radius: 14px;
    }
    .about-card::after {
      left: 1.2rem;
      right: 1.2rem;
    }
    .about-eyebrow {
      margin-bottom: 0.65rem;
    }
    .about-lead {
      margin-bottom: 0.6rem;
      font-size: 0.95rem;
      line-height: 1.5;
    }
    .about-text {
      margin-bottom: 0.5rem;
      font-size: 0.84rem;
      line-height: 1.58;
    }
    .about-focus {
      gap: 0.35rem;
      margin-top: 0.7rem;
      padding-top: 0.7rem;
    }
    .about-focus :global(.tag) {
      padding: 0.22rem 0.6rem;
      font-size: 0.7rem;
    }
    .hero-actions {
      gap: 0.7rem;
    }
    .hero-actions .btn {
      padding: 0.6rem 1.1rem;
      font-size: 0.85rem;
    }
    .hero-social {
      gap: 0.8rem;
    }
    .social-link {
      width: 40px;
      height: 40px;
    }
  }

  @media (max-height: 800px) and (min-width: 769px) {
    .hero-stage {
      gap: 1rem;
      padding-top: 4.5rem;
      padding-bottom: 3rem;
    }
    .hero-photo-wrap {
      width: min(160px, 20vw);
    }
    .hero-desc {
      --photo-w: min(160px, 20vw);
    }
  }

  @media (max-height: 740px) and (max-width: 768px) {
    .hero-stage.is-revealed {
      gap: 1.1rem;
      padding-top: 5.1rem;
      padding-bottom: 1rem;
    }
    .hero-stage.is-revealed .hero-photo-wrap {
      width: 52px;
    }
    .about-lead {
      font-size: 0.9rem;
    }
    .about-text {
      font-size: 0.8rem;
      line-height: 1.55;
    }
  }

  @media (max-height: 640px) and (max-width: 768px) {
    .hero-stage {
      gap: 0.75rem;
      padding-top: 5rem;
      padding-bottom: 2.5rem;
    }
    .hero-name {
      font-size: clamp(1.5rem, 6.5vw, 1.8rem);
    }
    .hero-subtitle {
      font-size: 0.84rem;
    }
    .hero-photo-wrap {
      width: min(32vw, 96px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero {
      position: relative;
      overflow: visible;
    }
    .hero-desc {
      position: static !important;
      opacity: 1 !important;
      transform: none !important;
      pointer-events: auto !important;
      max-width: 640px;
      margin: 0 auto;
      padding: 0;
    }
    .hero-desc {
